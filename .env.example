# server (lives on Hostinger VPS)
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://biab:biab@localhost:5432/biab
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-me-32-bytes-min-please!!
ALLOW_DEV_AUTH=true

# Blake
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# web
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000/collab
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# mobile
EXPO_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_WS_URL=ws://localhost:4000/collab

# Hostinger deploy (used by infra/deploy/hostinger.sh)
# Known host fingerprint on this Mac: 187.77.8.188 (needs SSH key)
HOSTINGER_SSH=user@YOUR-HOSTINGER-IP
HOSTINGER_PATH=/var/www/biab-collab
